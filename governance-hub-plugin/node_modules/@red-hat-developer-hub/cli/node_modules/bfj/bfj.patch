diff --git c/src/set-property.js i/src/set-property.js
new file mode 100644
index 0000000..0136455
--- /dev/null
+++ i/src/set-property.js
@@ -0,0 +1,27 @@
+'use strict'
+
+module.exports = setProperty
+
+/**
+ * Set an own data property on an object.
+ *
+ * A `__proto__` key must be defined rather than assigned, otherwise it mutates
+ * the object's prototype instead of creating the property that the JSON input
+ * represents.
+ *
+ * @param object: The object to set the property on.
+ * @param key:    The property key.
+ * @param value:  The property value.
+ **/
+function setProperty (object, key, value) {
+  if (key === '__proto__') {
+    Object.defineProperty(object, key, {
+      value,
+      writable: true,
+      enumerable: true,
+      configurable: true
+    })
+  } else {
+    object[key] = value
+  }
+}
